# .env.example — copy to .env (or .env.production) and fill in real values.
#
# In dev (docker compose up), .env is loaded by the web service.
# In production, .env.production is loaded by compose.prod.yaml.
# Production has additional fail-fast checks — missing DJANGO_SECRET_KEY,
# default DJANGO_ADMIN_URL, empty DJANGO_ALLOWED_HOSTS, or empty
# DB_PASSWORD will cause production settings to refuse to import.

# ──────────────────────────────────────────────
# Django core
# ──────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-50+-char-random-string

# Comma-separated; required in production. Empty / unset is rejected on import.
DJANGO_ALLOWED_HOSTS=planly.example.com

# Production must override this — shipping the default `admin/` is a fail-fast error.
# Pick a non-guessable prefix, e.g. `openssl rand -hex 6`/.
DJANGO_ADMIN_URL=admin/

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DB_NAME=planly
DB_USER=planly
DB_PASSWORD=planly
DB_HOST=localhost          # `db` inside docker compose
DB_PORT=5432
DB_CONN_MAX_AGE=600        # seconds; persistent connections per worker

# ──────────────────────────────────────────────
# Email (production)
# ──────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@planly.example.com

# ──────────────────────────────────────────────
# S3 / object storage (production — attachments & static media)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=planly-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=                  # leave empty for AWS; set for S3-compatible (MinIO, etc.)
AWS_S3_CUSTOM_DOMAIN=                 # optional CDN domain in front of the bucket

# ──────────────────────────────────────────────
# Gunicorn (production)
# ──────────────────────────────────────────────
# Reverse-proxy IPs that may set X-Forwarded-Proto. "*" is fine when the
# only thing in front of gunicorn is a known proxy on the private network.
FORWARDED_ALLOW_IPS=*
# Override the default 2*cores+1 worker count if you've measured otherwise.
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info

# ──────────────────────────────────────────────
# Planly limits
# ──────────────────────────────────────────────
PLANLY_MAX_ATTACHMENT_SIZE_MB=25      # per file; rejected by validators on upload
PLANLY_MAX_BUCKETS_PER_PLAN=200       # mirrors MS Planner limit
PLANLY_MAX_TASKS_PER_PLAN=9000        # mirrors MS Planner limit
