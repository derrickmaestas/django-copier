# .env.example — copy to .env (or .env.production) and fill in real values.
#
# In dev (docker compose up), .env is loaded by the web service.
# In production, .env.production is loaded by compose.production.yml.
# Production has additional fail-fast checks — missing DJANGO_SECRET_KEY,
# default DJANGO_ADMIN_URL, empty DJANGO_ALLOWED_HOSTS, or empty
# DB_PASSWORD will cause production settings to refuse to import.

# ──────────────────────────────────────────────
# Django core
# ──────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-50+-char-random-string

# Comma-separated; required in production.
DJANGO_ALLOWED_HOSTS={{ domain_name }}

# Production must override this — shipping the default `admin/` is a fail-fast error.
# Pick a non-guessable prefix, e.g. `openssl rand -hex 6`.
DJANGO_ADMIN_URL=admin/

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DB_NAME={{ package_slug }}
DB_USER={{ package_slug }}
DB_PASSWORD={{ package_slug }}
DB_HOST=localhost          # `db` inside docker compose
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ──────────────────────────────────────────────
# Email (production)
# ──────────────────────────────────────────────
EMAIL_HOST=smtp.{{ domain_name }}
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@{{ domain_name }}
{%- if use_attachments %}

# ──────────────────────────────────────────────
# S3 / object storage (production — attachments & static media)
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME={{ project_slug }}-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=                  # leave empty for AWS; set for S3-compatible (MinIO, etc.)
AWS_S3_CUSTOM_DOMAIN=                 # optional CDN domain in front of the bucket
{%- endif %}
{%- if auth_method == "oidc" %}

# ──────────────────────────────────────────────
# OIDC (corporate SSO)
# ──────────────────────────────────────────────
OIDC_DISCOVERY_URL=https://idp.{{ domain_name }}/.well-known/openid-configuration
OIDC_CLIENT_ID={{ project_slug }}
OIDC_CLIENT_SECRET=
OIDC_JWKS_URL=https://idp.{{ domain_name }}/jwks.json
OIDC_ISSUER=https://idp.{{ domain_name }}
OIDC_API_AUDIENCE={{ project_slug }}-api

# Internal CA bundle (if your IdP isn't signed by a public CA).
# Comment out for AWS / public IdPs.
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
{%- endif %}

# ──────────────────────────────────────────────
# Gunicorn (production)
# ──────────────────────────────────────────────
FORWARDED_ALLOW_IPS=*
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info
{%- if use_attachments %}

# ──────────────────────────────────────────────
# {{ package_slug | upper }} limits
# ──────────────────────────────────────────────
{{ package_slug | upper }}_MAX_ATTACHMENT_SIZE_MB=25
{%- endif %}
